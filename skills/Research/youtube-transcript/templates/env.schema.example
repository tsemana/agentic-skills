# Generic Varlock template for the YouTube Transcript skill.
#
# Copy this file to .env.schema in your local skill directory and adapt it to
# your own secret manager. Do not commit a populated .env or machine-specific
# .env.schema with private account paths.

# @type=string @required @sensitive
# Example direct environment passthrough:
GEMINI_API_KEY=${GEMINI_API_KEY}

# Example 1Password CLI pattern; replace vault/item/field for your setup:
# GEMINI_API_KEY=exec(`op read "op://VAULT/ITEM/FIELD"`)

# @type=string @sensitive=false
GEMINI_MODEL=gemini-2.5-flash

# @type=string @sensitive=false
TRANSCRIPT_OUTPUT_DIR=~/transcripts/youtube
